<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bibliomanager.controllers.LoansController"
            style="-fx-background-color: #1e1e2e;">

    <left>
        <VBox style="-fx-background-color: #181825; -fx-padding: 20; -fx-spacing: 8;"
              prefWidth="200">

            <Label text="📚 BiblioManager"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;
                          -fx-text-fill: #cdd6f4; -fx-padding: 0 0 20 0;"/>

            <Button text="🏠  Dashboard" maxWidth="Infinity"
                    onAction="#goToDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #a6adc8;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 10 16;
                           -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button text="📖  Books" maxWidth="Infinity"
                    onAction="#goToBooks"
                    style="-fx-background-color: transparent; -fx-text-fill: #a6adc8;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 10 16;
                           -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button text="👥  Members" maxWidth="Infinity"
                    onAction="#goToMembers"
                    style="-fx-background-color: transparent; -fx-text-fill: #a6adc8;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 10 16;
                           -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button text="📋  Loans" maxWidth="Infinity"
                    style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 10 16;
                           -fx-background-radius: 6; -fx-cursor: hand;"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Label fx:id="loggedUserLabel"
                   style="-fx-text-fill: #585b70; -fx-font-size: 12px;"/>
            <Button text="🚪  Logout" maxWidth="Infinity"
                    onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-text-fill: #f38ba8;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 10 16;
                           -fx-background-radius: 6; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-padding: 30; -fx-spacing: 16;">

            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="📋 Loans"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;
                              -fx-text-fill: #cdd6f4;"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="+ Issue Loan" onAction="#handleIssueLoan"
                        style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e;
                               -fx-font-weight: bold; -fx-background-radius: 6;
                               -fx-padding: 8 16; -fx-cursor: hand;"/>
            </HBox>

            <TableView fx:id="loansTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #313244; -fx-border-color: #45475a;
                              -fx-border-radius: 8; -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="colBook"   text="Book"        prefWidth="200"/>
                    <TableColumn fx:id="colMember" text="Member"      prefWidth="160"/>
                    <TableColumn fx:id="colLoan"   text="Loan Date"   prefWidth="110"/>
                    <TableColumn fx:id="colDue"    text="Due Date"    prefWidth="110"/>
                    <TableColumn fx:id="colReturn" text="Return Date" prefWidth="110"/>
                    <TableColumn fx:id="colStatus" text="Status"      prefWidth="90"/>
                </columns>
            </TableView>

            <HBox spacing="10">
                <Button text="✅ Return Book" onAction="#handleReturnBook"
                        style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e;
                               -fx-font-weight: bold; -fx-background-radius: 6;
                               -fx-padding: 8 16; -fx-cursor: hand;"/>
                <Button text="📄 Export PDF" onAction="#handleExportPDF"
                        style="-fx-background-color: #cba6f7; -fx-text-fill: #1e1e2e;
                               -fx-font-weight: bold; -fx-background-radius: 6;
                               -fx-padding: 8 16; -fx-cursor: hand;"/>
                <Label fx:id="statusLabel"
                       style="-fx-text-fill: #a6adc8; -fx-font-size: 12px;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>